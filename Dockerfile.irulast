FROM golang:1.27.3-bookworm@sha256:d9b6a1beb9474adc2a1ce842573639b44b2a0dd49b6669f51d3821baf9ec37c9 AS build
ENV GOMAXPROCS=2 GOFLAGS="-mod=readonly -p=2" CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG SOURCE_REVISION
ARG RELEASE_DATE=2026-10-30T00:00:00Z
ARG RELEASE_TAG=RELEASE.2026-10-30T00-00-00Z.irulast.1
RUN test -n "$SOURCE_REVISION" && go build -trimpath -ldflags "-s -w -X github.com/minio/minio/cmd.Version=$RELEASE_DATE -X github.com/minio/minio/cmd.ReleaseTag=$RELEASE_TAG -X github.com/minio/minio/cmd.CommitID=$SOURCE_REVISION -X github.com/minio/minio/cmd.ShortCommitID=$SOURCE_REVISION" -o /out/minio .

FROM alpine:3.24.2@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6
RUN apk upgrade --no-cache && apk add --no-cache ca-certificates curl && addgroup -g 1000 minio && adduser -D -u 1000 -G minio minio
ARG SOURCE_REVISION
LABEL org.opencontainers.image.source="https://github.com/irulast/minio" \
      org.opencontainers.image.revision="$SOURCE_REVISION" \
      org.opencontainers.image.licenses="AGPL-3.0-or-later" \
      org.opencontainers.image.vendor="irulast"
ENV MINIO_ACCESS_KEY_FILE=access_key \
    MINIO_SECRET_KEY_FILE=secret_key \
    MINIO_ROOT_USER_FILE=access_key \
    MINIO_ROOT_PASSWORD_FILE=secret_key \
    MINIO_KMS_SECRET_KEY_FILE=kms_master_key \
    MINIO_CONFIG_ENV_FILE=config.env \
    MINIO_UPDATE=off \
    MINIO_API_TRUSTED_PROXIES=none
COPY --from=build /out/minio /usr/bin/minio
COPY LICENSE CREDITS /licenses/
COPY dockerscripts/docker-entrypoint.sh /usr/bin/docker-entrypoint.sh
USER 1000:1000
EXPOSE 9000 9090
VOLUME ["/data"]
ENTRYPOINT ["/usr/bin/docker-entrypoint.sh"]
CMD ["minio"]
